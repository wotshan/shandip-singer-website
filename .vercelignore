# Upload excludes for Vercel (the build then regenerates anything it needs).
#
# The DEFAULTS already skip node_modules/.git; these are the repo-specific ones.
# Anything the BUILD needs must stay: client/, server/, shared/, drizzle/,
# api/, scripts/, and every config file are all required.

# Build output IS uploaded here — do NOT add a bare `dist` line.
#
# `vercel.json` sets functions."api/index.ts".includeFiles = "dist/public/**", so
# Vercel BUILDS the serverless function locally ("prebuilt") and traces the SPA
# files into it. Ignoring `dist` makes that trace fail at deploy time with:
#     Error: ENOENT: no such file or directory,
#       readlink '/vercel/path0/dist/public/assets/index-*.css'
# The output is only ~1.7 MB and the build regenerates it anyway.
dist/**/*.map

# Local env + logs (never upload secrets)
.env
.env.*
!.env.example
.webapp-logs
*.log

# Sandbox-only scratch: screenshots, version snapshots and helper assets that
# have nothing to do with the deployed app.
shots
shots2
shots3
shots4
shots_admin
shots_cal
shots_intro
tiles
tmp_capture
downloads
gallery_src
readme_assets
*.pid

# Editor / OS noise
.DS_Store
