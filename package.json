{
  "name": "webapp-fullstack",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch server/_core/index.ts",
    "dev:web": "vite",
    "build": "pnpm build:web && pnpm build:api",
    "build:web": "vite build",
    "build:api": "node scripts/build-server.mjs",
    "build:api:vercel": "node scripts/build-vercel-fn.mjs",
    "build:vercel": "vercel build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:apply": "tsx scripts/apply-sql-migration.ts",
    "db:check": "tsx scripts/check-schema.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@hono/trpc-server": "0.4.2",
    "@neondatabase/serverless": "1.2.0",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.104.2",
    "@trpc/client": "11.19.0",
    "@trpc/react-query": "11.19.0",
    "@trpc/server": "11.19.0",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.7",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "lucide-react": "1.56.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "superjson": "2.2.6",
    "tailwind-merge": "3.7.0",
    "wouter": "3.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
