# ── Raag Sargam — environment variables ───────────────────────────────────────
#
# Copy this file to `.env` (`cp .env.example .env`) and fill in real values.
# `.env` is gitignored — NEVER commit a real one, and never commit real secrets.
#
# On Vercel, do NOT upload `.env`: add each key under
#   Project → Settings → Environment Variables
# for the Production, Preview and Development environments as needed.
#
# Nothing here is optional unless marked so. The server validates the required
# ones at boot (server/_core/env.ts) and refuses to start without them.

# ── Database ──────────────────────────────────────────────────────────────────
# Postgres connection string. On Neon/Supabase this is under
#   Neon:     Dashboard → Project → Connection Details → "Pooled" connection string
#   Supabase: Project Settings → Database → Connection pooling → URI
# Prefer the POOLED URL for the running app (serverless-safe: one HTTP/TCP hop
# through the pooler instead of a direct connection per instance).
# NOTE: drizzle-kit migrations need the DIRECT (non-pooled) URL — see
# drizzle.config.ts. You can keep the direct URL here for local migrate runs and
# set the pooled URL only in the hosting provider's env vars.
DATABASE_URL=postgres://user:password@host/dbname

# ── DB driver + pool ──────────────────────────────────────────────────────────
# "tcp"  = node-postgres pool. Works on any Postgres; the default. Best for a
#          resident process (Docker / Cloud Run / local dev).
# "http" = Neon serverless HTTP driver (@neondatabase/serverless). One request per
#          query, no TCP pool — the right choice for a scale-to-zero serverless
#          host on Neon. Requires a Neon DATABASE_URL.
# NOTE: interactive transactions do not exist on "http"; the app uses the
# atomic() helper (server/_core/db.ts) which works on both drivers.
DB_DRIVER=tcp

# Max simultaneous connections this app's pool may hold (tcp driver only).
# Raise for a busy resident process; keep SMALL (1-3) on a serverless host, where
# every concurrent instance holds its own pool and the database — not the app —
# is what runs out of connections first.
DB_POOL_MAX=2

# ── Auth / sessions ───────────────────────────────────────────────────────────
# Secret used to SIGN the admin session cookie (JWT, HS256). Any long random
# string works. Generate one with:  openssl rand -base64 48
# Changing it invalidates every existing admin session (the admin just logs in
# again). Required — the server will not boot without it.
JWT_SECRET=replace-with-a-long-random-secret

# Which auth provider to use. "local" is the only implemented value (the site has
# exactly ONE admin and NO signup — the admin row is bootstrapped server-side in
# server/admin.ts, and its password is stored only as a bcrypt hash). "sso" is a
# reserved, unimplemented seam.
AUTH_PROVIDER=local

# ── App identity ──────────────────────────────────────────────────────────────
# Used to name the session cookie (app_session_<slug>) so two apps on one host
# cannot clobber each other's session. Keep it stable after first deploy.
APP_SLUG=shandip-singer-website

# ── Runtime ───────────────────────────────────────────────────────────────────
# "production" makes the server serve the built SPA (dist/public) and enables
# secure cookies. Use "development" locally. Vercel sets NODE_ENV=production for
# you; the Dockerfile sets it explicitly.
NODE_ENV=development

# Port the resident Node server listens on. Vercel supplies its own PORT; this
# value is what `pnpm dev` / the Docker runtime uses.
PORT=3000

# Port the dev-only API process listens on (Vite proxies /trpc, /app-storage and
# /api here). Local development only — ignored in production.
API_PORT=3001

# ── File storage (OPTIONAL) ───────────────────────────────────────────────────
# The platform's scoped object-storage proxy, used only by the admin image/audio
# uploader (server/_core/storage.ts). Leave both blank to run without uploads:
# the admin can still paste an external URL or a local /images/... path. When
# both are set, the browser uploads through a short-lived signed URL and the
# app never holds raw object-store credentials.
APP_STORAGE_PRESIGN_URL=
APP_STORAGE_TOKEN=
