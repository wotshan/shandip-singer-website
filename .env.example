# Copy to `.env` and fill in.
#
# The PUBLIC site needs none of these — it is frontend-only. They are used only
# by the scaffold's server/API layer, which the public site does not call.
# Never commit a real `.env` (it is gitignored).

DATABASE_URL=
DB_DRIVER=tcp
DB_POOL_MAX=2
JWT_SECRET=
AUTH_PROVIDER=local
APP_SLUG=shandip-singer-website
NODE_ENV=development
PORT=3000
