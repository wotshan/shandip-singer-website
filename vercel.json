{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:web && pnpm build:api:vercel",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "dist/public/**"
    }
  },
  "rewrites": [
    { "source": "/trpc", "destination": "/api" },
    { "source": "/trpc/(.*)", "destination": "/api" },
    { "source": "/app-storage", "destination": "/api" },
    { "source": "/app-storage/(.*)", "destination": "/api" },
    { "source": "/health",               "destination": "/api" },
    { "source": "/api/health",           "destination": "/api" },
    { "source": "/api/trpc/(.*)",        "destination": "/api" },
    { "source": "/api/app-storage/(.*)", "destination": "/api" },
    { "source": "/api/_jobs/(.*)",       "destination": "/api" },

    { "source": "/((?!api/).*)", "destination": "/api" }
  ]
}
